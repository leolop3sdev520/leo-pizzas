{
  "editor.fontVariations": false,

  "editor.semanticHighlighting.enabled": true,
  "editor.semanticTokenColorCustomizations": {
    "rules": {
      "keyword": "#C678DD",
      "class": "#baf7ff",
      "interface": "#56B6C2",
      "type": "#56B6C2",
      "string": "#CE9178",
      "variable": "#e59eca",
      "variable.readonly": "#ffc5e6",
      "parameter": "#ABB2BF",
      "property": "#ffeece",
      "function": "#88d675",
      "method": "#88d675"
    }
  }
}
